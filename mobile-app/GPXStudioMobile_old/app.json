{
    "expo": {
        "name": "GPX Navigate",
        "slug": "gpx-navigate",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "gpx.navigate",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "splash": {
            "image": "./assets/images/splash-icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
        },
        "ios": {
            "supportsTablet": true,
            "icon": "./assets/images/icon.png",
            "infoPlist": {
                "NSLocationWhenInUseUsageDescription": "This app needs access to location to show your position on the map and track GPX routes."
            },
            "bundleIdentifier": "com.z4mb0.gpx.navigate"
        },
        "android": {
            "icon": "./assets/images/icon.png",
            "adaptiveIcon": {
                "foregroundImage": "./assets/images/adaptive-icon.png",
                "backgroundColor": "#ffffff"
            },
            "edgeToEdgeEnabled": true,
            "permissions": [
                "ACCESS_COARSE_LOCATION",
                "ACCESS_FINE_LOCATION",
                "ACCESS_COARSE_LOCATION",
                "ACCESS_FINE_LOCATION"
            ],
            "package": "com.z4mb0.gpx.navigate"
        },
        "web": {
            "bundler": "metro",
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": ["expo-router"],
        "experiments": {
            "typedRoutes": true
        }
    }
}
